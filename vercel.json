{
  "rewrites": [
    { "source": "/api/analyze-assessment-photo", "destination": "/api/ai?action=analyze-assessment-photo" },
    { "source": "/api/score-claim-fraud", "destination": "/api/ai?action=score-claim-fraud" },
    { "source": "/api/score-lead", "destination": "/api/ai?action=score-lead" },
    { "source": "/api/search-leads", "destination": "/api/ai?action=search-leads" },
    { "source": "/api/estimate-exchange-rate", "destination": "/api/ai?action=estimate-exchange-rate" },
    { "source": "/api/create-api-developer", "destination": "/api/api-partners?action=create-developer" },
    { "source": "/api/create-api-key", "destination": "/api/api-partners?action=create-key" },
    { "source": "/api/v1/:path*", "destination": "/api/v1?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
